const express = require("express");
const cors = require("cors");
require("dotenv").config();

const app = express();

app.use(cors());
app.use(express.json());

app.get("/", (req, res) => {
    res.json({
        success: true,
        message: "FeesLedger Backend is running"
    });
});

app.get("/api/health", (req, res) => {
    res.json({
        success: true,
        message: "FeesLedger API is working"
    });
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, "0.0.0.0", () => {
    console.log(`FeesLedger backend running on port ${PORT}`);
});
